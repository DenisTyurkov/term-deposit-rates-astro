---
// Banner CTA driving visitors from the rate tables into the /best-rate-finder
// lead-capture quiz. Styled in the SummaryCards idiom (soft blue gradient,
// light border, left accent bar, emoji icon) so it reads as part of the page
// rather than an ad — only the button carries the solid action color.
// Self-contained section (own container + top padding, no bottom padding —
// the table below brings its own) so pages can drop it directly above a table.
---
<section class="max-w-7xl mx-auto px-4 pt-8">
  <div class="bg-gradient-to-r from-blue-50 to-cyan-100 border border-blue-300 rounded-lg shadow-sm hover:shadow-md transition-all duration-200 relative overflow-hidden">
    <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-blue-400 to-cyan-500"></div>
    <div class="px-5 py-5 sm:px-6 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8">
      <div class="flex items-start gap-3 flex-1">
        <span class="text-2xl flex-shrink-0" aria-hidden="true">🎯</span>
        <div>
          <h2 class="text-lg font-bold text-gray-900 leading-tight">Not sure which term deposit is right for you?</h2>
          <p class="text-sm text-gray-600 mt-1">
            Answer four quick questions and we'll match you with today's best rates for your deposit amount and term.
          </p>
        </div>
      </div>
      <div class="pl-10 sm:pl-0 sm:text-center flex-shrink-0">
        <a
          href="/best-rate-finder"
          class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-5 rounded-lg shadow-sm transition-colors"
        >
          Find My Best Rate &rarr;
        </a>
        <p class="text-xs text-gray-500 mt-1.5">Takes 60 seconds &middot; Free</p>
      </div>
    </div>
  </div>
</section>
