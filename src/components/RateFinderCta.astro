---
// Banner CTA driving visitors from the rate tables into the /best-rate-finder
// lead-capture quiz. Self-contained section (own container + top padding, no
// bottom padding — the table below brings its own) so pages can drop it
// directly above a rates table.
---
<section class="max-w-7xl mx-auto px-4 pt-8">
  <div class="bg-gradient-to-r from-blue-600 to-blue-700 rounded-lg shadow-lg">
    <div class="px-6 py-6 sm:px-8 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8">
      <div class="flex-1">
        <h2 class="text-xl sm:text-2xl font-bold text-white">Not sure which term deposit is right for you?</h2>
        <p class="text-blue-100 mt-1">
          Answer four quick questions and we'll match you with today's best rates for your deposit amount and term.
        </p>
      </div>
      <div class="text-left sm:text-center shrink-0">
        <a
          href="/best-rate-finder"
          class="inline-block bg-white text-blue-700 hover:bg-blue-50 font-semibold py-3 px-6 rounded-lg shadow transition-colors"
        >
          Find My Best Rate &rarr;
        </a>
        <p class="text-xs text-blue-200 mt-2">Takes 60 seconds &middot; Free &middot; No obligation</p>
      </div>
    </div>
  </div>
</section>
