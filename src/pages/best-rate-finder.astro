---
import Layout from "../layouts/Layout.astro";
import BankLogo from "../components/BankLogo.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import { rateFinderData } from "../lib/rates";
import { longDateTime } from "../lib/format";
import { webApplicationSchema, ROOT_URL } from "../lib/schema";

const finder = rateFinderData();
const pageUrl = `${ROOT_URL}/best-rate-finder/`;

const title = "Best Term Deposit Rate Finder NZ — Your Rate in 60 Seconds";
const description =
  "Answer four quick questions and we'll match you with today's best NZ term deposit rates for your amount and term. Live rates from every major bank, updated daily.";

const jsonLd = [
  webApplicationSchema(
    "Term Deposit Rate Finder",
    "Answer four quick questions to find the best NZ term deposit rates for your deposit amount and term. Live rates from every major bank, updated daily.",
    pageUrl
  ),
];
const breadcrumbs = [
  { name: "Home", url: `${ROOT_URL}/` },
  { name: "Best Rate Finder", url: pageUrl },
];

// The reward step renders client-side from this blob after a successful submit.
const quizData = {
  updatedLabel: finder.latestScrapeAt ? longDateTime(finder.latestScrapeAt) : null,
  buckets: finder.buckets,
};

const amountOptions = [
  { value: "Under $10k", bound: 1000, hint: "Getting started" },
  { value: "$10k – $50k", bound: 10000, hint: "Building savings" },
  { value: "$50k – $100k", bound: 50000, hint: "Serious saver" },
  { value: "$100k+", bound: 100000, hint: "Large deposit" },
];
const termOptions = [
  { value: "Under 6 months", bucket: "under6", hint: "Quick access to funds" },
  { value: "6–12 months", bucket: "m6to12", hint: "The most popular range" },
  { value: "1–2 years", bucket: "y1to2", hint: "Lock in a solid rate" },
  { value: "2+ years", bucket: "y2plus", hint: "Maximum certainty" },
];
const bankOptions = ["ANZ", "ASB", "BNZ", "Westpac", "Kiwibank", "TSB Bank"];
const timingOptions = [
  { value: "Ready to invest now", hint: "My money is available today" },
  { value: "Within a month", hint: "A deposit is maturing soon" },
  { value: "In 1–3 months", hint: "Planning ahead" },
  { value: "Just researching", hint: "Comparing my options" },
];

const optionClass =
  "w-full text-left border border-gray-300 rounded-lg p-4 hover:border-blue-500 hover:bg-blue-50 transition-colors";
---
<Layout title={title} description={description} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Find Your Best Term Deposit Rate</h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Answer four quick questions and we'll match you with today's best rates for your
        deposit amount and term — from every major NZ bank.
      </p>
      {finder.latestScrapeAt && (
        <p class="text-sm text-gray-500 mt-2">Rates last updated: {longDateTime(finder.latestScrapeAt)}</p>
      )}
    </div>

    <div class="bg-white rounded-lg shadow-lg p-6 sm:p-8" data-quiz>
      <script type="application/json" id="quiz-rates-data" is:inline set:html={JSON.stringify(quizData)} />

      <noscript>
        <p class="text-center text-gray-600 py-4">
          The rate finder needs JavaScript. You can still
          <a href="/" class="text-blue-600 underline">compare every bank's rates here</a>.
        </p>
      </noscript>

      <div data-quiz-progress>
        <div class="flex justify-between items-center text-sm text-gray-600 mb-2">
          <span data-quiz-step-label>Step 1 of 5</span>
          <button type="button" data-quiz-back class="text-blue-600 hover:text-blue-700 font-medium hidden">
            &larr; Back
          </button>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-2 mb-6">
          <div data-quiz-bar class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: 20%"></div>
        </div>
      </div>

      <form data-quiz-form novalidate>
        <input type="hidden" name="quiz_deposit_amount" />
        <input type="hidden" name="quiz_term_length" />
        <input type="hidden" name="quiz_current_bank" />
        <input type="hidden" name="quiz_goal_timing" />

        <fieldset data-quiz-step="1">
          <legend class="text-xl font-semibold text-gray-900 mb-4">How much are you looking to deposit?</legend>
          <div class="space-y-3">
            {amountOptions.map((opt) => (
              <button type="button" class={optionClass} data-quiz-option data-answer="quiz_deposit_amount"
                data-value={opt.value} data-bound={opt.bound}>
                <span class="font-medium text-gray-900">{opt.value}</span>
                <span class="block text-sm text-gray-500 mt-0.5">{opt.hint}</span>
              </button>
            ))}
          </div>
        </fieldset>

        <fieldset data-quiz-step="2" hidden>
          <legend class="text-xl font-semibold text-gray-900 mb-4">How long do you want to invest for?</legend>
          <div class="space-y-3">
            {termOptions.map((opt) => (
              <button type="button" class={optionClass} data-quiz-option data-answer="quiz_term_length"
                data-value={opt.value} data-bucket={opt.bucket}>
                <span class="font-medium text-gray-900">{opt.value}</span>
                <span class="block text-sm text-gray-500 mt-0.5">{opt.hint}</span>
              </button>
            ))}
          </div>
        </fieldset>

        <fieldset data-quiz-step="3" hidden>
          <legend class="text-xl font-semibold text-gray-900 mb-4">Who do you currently bank with?</legend>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {bankOptions.map((bank) => (
              <button type="button"
                class="flex flex-col items-center justify-center gap-2 border border-gray-300 rounded-lg p-4 hover:border-blue-500 hover:bg-blue-50 transition-colors"
                data-quiz-option data-answer="quiz_current_bank" data-value={bank}>
                <BankLogo name={bank} class="h-8 w-auto object-contain" />
                <span class="text-sm font-medium text-gray-900">{bank}</span>
              </button>
            ))}
            <button type="button"
              class="flex items-center justify-center border border-gray-300 rounded-lg p-4 hover:border-blue-500 hover:bg-blue-50 transition-colors text-sm font-medium text-gray-900"
              data-quiz-option data-answer="quiz_current_bank" data-value="Other">
              Other
            </button>
            <button type="button"
              class="flex items-center justify-center border border-gray-300 rounded-lg p-4 hover:border-blue-500 hover:bg-blue-50 transition-colors text-sm font-medium text-gray-900"
              data-quiz-option data-answer="quiz_current_bank" data-value="None">
              No bank yet
            </button>
          </div>
        </fieldset>

        <fieldset data-quiz-step="4" hidden>
          <legend class="text-xl font-semibold text-gray-900 mb-4">When are you looking to invest?</legend>
          <div class="space-y-3">
            {timingOptions.map((opt) => (
              <button type="button" class={optionClass} data-quiz-option data-answer="quiz_goal_timing"
                data-value={opt.value}>
                <span class="font-medium text-gray-900">{opt.value}</span>
                <span class="block text-sm text-gray-500 mt-0.5">{opt.hint}</span>
              </button>
            ))}
          </div>
        </fieldset>

        <fieldset data-quiz-step="5" hidden>
          <legend class="text-xl font-semibold text-gray-900 mb-1">Where should we send your rate summary?</legend>
          <p class="text-sm text-gray-600 mb-4">
            See your matched rates instantly — we'll also send you the summary and let you know when better rates appear.
          </p>

          <div class="hidden" aria-hidden="true">
            <label>Don't fill this out if you're human: <input type="text" name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </div>

          <div class="space-y-4">
            <div>
              <label for="quiz-name" class="block text-sm font-medium text-gray-700 mb-2">Name</label>
              <input type="text" id="quiz-name" name="name" required autocomplete="name" placeholder="Your name"
                class="block w-full py-3 px-3 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 text-lg" />
            </div>
            <div>
              <label for="quiz-email" class="block text-sm font-medium text-gray-700 mb-2">Email</label>
              <input type="email" id="quiz-email" name="email" required autocomplete="email" placeholder="you@example.com"
                class="block w-full py-3 px-3 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 text-lg" />
            </div>
            <div>
              <label for="quiz-phone" class="block text-sm font-medium text-gray-700 mb-2">Phone</label>
              <input type="tel" id="quiz-phone" name="phone" required autocomplete="tel" placeholder="021 234 5678"
                class="block w-full py-3 px-3 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 text-lg" />
            </div>
          </div>

          <p data-quiz-error class="hidden text-sm text-red-600 mt-4" role="alert"></p>

          <button type="submit" data-quiz-submit
            class="w-full mt-6 bg-blue-600 hover:bg-blue-700 disabled:bg-blue-300 text-white font-semibold text-lg py-3 px-6 rounded-lg transition-colors">
            Show My Best Rates
          </button>
          <p class="text-xs text-gray-500 mt-3 text-center">
            By submitting you agree to receive your personalised rate summary and occasional rate updates by email.
            Unsubscribe anytime. We never share your details with third parties.
          </p>
        </fieldset>
      </form>

      <div data-quiz-results hidden>
        <div class="text-center mb-6">
          <div class="text-4xl mb-2">🎉</div>
          <h2 class="text-2xl font-bold text-gray-900" data-quiz-results-heading>Your best rates</h2>
          <p class="text-gray-600 mt-1" data-quiz-results-sub></p>
        </div>
        <div class="space-y-3" data-quiz-results-list></div>
        <div class="mt-6 text-center">
          <a href="/" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors">
            Compare all banks &amp; terms
          </a>
        </div>
      </div>
    </div>

    <p class="text-center text-sm text-gray-500 mt-6">
      Free to use. Rates are sourced daily from public bank data — we don't sell your details.
    </p>
  </div>

  <RelatedLinks exclude="/best-rate-finder" />

  <script>
    import "../scripts/quiz.ts";
  </script>
</Layout>
